# Allowed origins for CORS (e.g. your deployed React frontend URL on Vercel)
# Multiple origins can be comma-separated: http://localhost:5173,https://ventidy.vercel.app
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app

# Optional: Set to 1 only if you want to load full Qwen LLM locally (keep 0 for Vercel)
VENTIDY_LOAD_LLM=0
