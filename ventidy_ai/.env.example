# Allowed origins for CORS (e.g. your deployed React frontend URL)
# Multiple origins can be comma-separated: http://localhost:5173,https://ventidy.vercel.app
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app

# Port for the server (default: 8000)
PORT=8000

# Optional: External LLM API Key (OpenAI / Groq / Gemini compatible endpoint)
# Leave blank to use 100% local deterministic matching with zero latency and 0% hallucinations.
# VENTIDY_LLM_API_KEY=your_api_key_here
# VENTIDY_LLM_BASE_URL=https://api.openai.com/v1
# VENTIDY_LLM_MODEL=gpt-4o-mini
