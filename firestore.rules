rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public "Get in Touch" form: anyone can create, only the admin can read/modify
    match /consultation_inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fullName','email','message','status','createdAt'])
                    && request.resource.data.fullName is string && request.resource.data.fullName.size() < 200
                    && request.resource.data.email is string && request.resource.data.email.size() < 200
                    && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read, update, delete: if request.auth != null
                    && request.auth.token.email == 'test@gmail.com';
    }
  }
}
